<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f9; color: #333; padding: 20px; }
        .container { max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .header { text-align: center; border-bottom: 2px solid #ff6600; padding-bottom: 10px; margin-bottom: 20px; }
        .header h1 { color: #ff6600; margin: 0; }
        .field { margin-bottom: 12px; }
        .field strong { display: block; color: #555; font-size: 13px; }
        .message { white-space: pre-wrap; background: #f7f7f7; padding: 15px; border-radius: 4px; margin-top: 10px; }
        .footer { font-size: 12px; color: #777; text-align: center; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Club de Baloncesto</h1>
        </div>
        <h2>Nuevo mensaje de contacto</h2>
        <div class="field">
            <strong>Nombre</strong>
            <%= nombre %>
        </div>
        <div class="field">
            <strong>Email</strong>
            <%= email %>
        </div>
        <div class="field">
            <strong>Teléfono</strong>
            <%= telefono || 'No proporcionado' %>
        </div>
        <div class="field">
            <strong>Mensaje</strong>
            <div class="message"><%= mensaje %></div>
        </div>
        <div class="footer">
            &copy; 2026 Club de Baloncesto. Todos los derechos reservados.
        </div>
    </div>
</body>
</html>
